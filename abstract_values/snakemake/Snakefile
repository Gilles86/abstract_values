rule compute_fisher_information:
    input:
        glmsingle = f"{DERIV}/glmsingle{{smooth}}/sub-{{subject}}/_done.touch",
        mask      = mask_input(FI_ROIS_VONMISES),
    output:
        # Sentinel — actual FI TSVs live at
        # derivatives/encoding_models/vonmises/sub-XX/[ses-X/]func/... per
        # compute_fisher_information.py.
        f"{DERIV}/fisher_information_vonmises{{smooth}}/sub-{{subject}}/"
        f"sub-{{subject}}_roi-{{roi}}_ses-{{session}}.done",
    log: "logs/fi_vonmises{smooth}_{subject}_{roi}_ses{session}.log"
    resources: cpus_per_task=4, mem_mb=16_000, runtime=60,
    params:
        ses_export=lambda wc: "" if wc.session == "all" else f"SESSION={wc.session} ",
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "ROI={wildcards.roi} {params.ses_export}"
        "SMOOTHED=$([[ '{wildcards.smooth}' == '_smoothed' ]] && echo 1 || echo 0) "
        "bash {REPO}/abstract_values/encoding_models/slurm_jobs/compute_fisher_information.sh && "
        "mkdir -p $(dirname {output}) && touch {output}"

