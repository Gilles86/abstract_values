rule compute_fisher_information_aprf_session_shift:
    """Per-condition Fisher information for the session-shift aPRF model
    (mode_1/mode_2 tuning). Feeds fisher_information_per_condition.py,
    which needs both the top-N (nv=100) and FDR-thresholded (nv=fdr05)
    voxel-selection variants, per session — no pooled "all" variant since
    the whole point is that tuning differs per session.
    """
    input:
        aprf = lambda wc: aprf_r2(wc.subject, "aprf_session_shift", wc.smooth),
        mask = mask_input(FI_ROIS_APRF),
    output:
        # Sentinel — actual FI TSVs live at
        # derivatives/encoding_models/aprf-session-shift/sub-XX/ses-X/func/...
        # per compute_fisher_information_aprf.py --model session-shift.
        f"{DERIV}/fisher_information_aprf_session_shift{{smooth}}/sub-{{subject}}/"
        f"sub-{{subject}}_roi-{{roi}}_nv-{{nv}}_ses-{{session}}.done",
    log: "logs/fi_aprf_session_shift{smooth}_{subject}_{roi}_nv{nv}_ses{session}.log"
    resources: cpus_per_task=4, mem_mb=16_000, runtime=60,
    wildcard_constraints:
        session = r"\d+",
    params:
        nv_export=lambda wc: (
            "FDR_ALPHA=0.05 " if wc.nv == "fdr05" else f"N_VOXELS={wc.nv} "),
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "ROI={wildcards.roi} MODEL=session-shift SESSION={wildcards.session} "
        "{params.nv_export}"
        "SMOOTHED=$([[ '{wildcards.smooth}' == '_smoothed' ]] && echo 1 || echo 0) "
        "bash {REPO}/abstract_values/encoding_models/slurm_jobs/compute_fisher_information_aprf.sh && "
        "mkdir -p $(dirname {output}) && touch {output}"


# ─────────────────────────────────────────────────────────────────────────────
# Expected decoded value (aprf-session-shift): simulate-decode-aggregate per
# stimulus to get bias / SD per CHF, on the trained-grid prior. Fanout over
# selection (top-N vs FDR05) × noise model (full residual covariance vs
# iid spherical). All variants share the same encoding fit; cost is the
# decode/simulate loop, which the SLURM wrapper handles.
# ─────────────────────────────────────────────────────────────────────────────
rule compute_expected_decoded_value_aprf:
    input:
        aprf_ss = lambda wc: aprf_r2(wc.subject, "aprf_session_shift", wc.smooth),
        mask    = mask_input(EU_ROIS),
    output:
        # Sentinel — actual TSVs live at
        # derivatives/encoding_models/aprf-session-shift/sub-XX/ses-X/func/...
        # with filename mask-<roi>_nvoxels-<nv>_nsims-1000[_noise-spherical]
        # [_smoothed]_desc-expected_decoded_pe.tsv.
        f"{DERIV}/expected_decoded_value_aprf{{smooth}}/sub-{{subject}}/"
        f"sub-{{subject}}_roi-{{roi}}_nv-{{nv}}_noise-{{noise}}.done",
    log: "logs/eu_aprf{smooth}_{subject}_{roi}_nv{nv}_noise{noise}.log"
    resources: cpus_per_task=8, mem_mb=32_000, runtime=240,
    params:
        nv_export=lambda wc: (
            f"FDR_ALPHA=0.05 N_VOXELS=0 " if wc.nv == "fdr05"
            else f"N_VOXELS={wc.nv} "),
        # "spherical" wildcard → SPHERICAL=1, "residual" → SPHERICAL=0.
        sph_flag=lambda wc: "1" if wc.noise == "spherical" else "0",
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "ROI={wildcards.roi} HEMI=None {params.nv_export}"
        "SPHERICAL={params.sph_flag} "
        "SMOOTHED=$([[ '{wildcards.smooth}' == '_smoothed' ]] && echo 1 || echo 0) "
        "bash {REPO}/abstract_values/encoding_models/slurm_jobs/compute_expected_decoded_value_aprf.sh && "
        "mkdir -p $(dirname {output}) && touch {output}"
