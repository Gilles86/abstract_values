"""
Cluster-side pipeline for abstract_values.

Covers fmriprep -> masks -> GLMsingle (smoothed + unsmoothed) -> encoding-model
fan-out (aprf, aprf_cv, aprf_session_shift{,_cv}, aprf_weighted{,_cv},
aprf_gauss{,_cv,_session_shift{,_cv}}, vonmises{,_cv}) -> decoding
(per ROI x n_voxels x lambda) -> Fisher info.

Pre-cluster steps (SMB rsync, BIDS conversion, push to cluster) stay in
ingest_new_session.sh. This Snakefile assumes BIDS data is already on the
cluster under {bids_folder}.

Wildcard conventions:
    {subject}      e.g. "07"
    {smooth}       either "" (unsmoothed) or "_smoothed"
    {roi}          ROI desc, e.g. "BensonV1", "NPCr"
    {nv}           decode n_voxels
    {lam}          decode lambda
    {session}      "all" (pooled) or a numeric session for per-session FI

Outputs are real per-wildcard files where the underlying script produces one
(encoding-model parameter NIfTIs, decode TSVs, FI TSVs). For stages that
produce a directory of files (fmriprep, GLMsingle), a representative file is
used as the sentinel.
"""

import re
from itertools import product
from pathlib import Path

configfile: "abstract_values/snakemake/config.yaml"

EXPECTED_MRI_SESSIONS = int(config.get("expected_mri_sessions", 2))
SUBJECT_EXPECTED_OVERRIDES = {
    str(k): int(v) for k, v in config.get("subject_expected_overrides", {}).items()
}
_rc = config.get("require_complete", True)
if isinstance(_rc, str):
    _rc = _rc.strip().lower() not in ("false", "0", "no", "off", "")
REQUIRE_COMPLETE = bool(_rc)

def expected_sessions(subject):
    return SUBJECT_EXPECTED_OVERRIDES.get(subject, EXPECTED_MRI_SESSIONS)

# ── auto-discover subjects + session counts from the BIDS folder ─────────────
# No more editing/pushing config.yaml when a new subject hits the cluster —
# rsync to {bids_folder}/sub-XX/ and the next driver run picks it up.
#
# Optional config knobs (all empty by default):
#   subjects_include : if non-empty, restrict to this list
#   subjects_exclude : drop these subjects from auto-discovered list
_bids_root = Path(config["bids_folder"])
_sub_re    = re.compile(r"^sub-(.+)$")
_ses_re    = re.compile(r"^ses-(\d+)$")

def _discover():
    """Walk {bids_folder} once and return ({subject: session_count}, sorted list).
    A subject must contain at least one ``ses-<int>`` directory with a
    ``func/`` subdir (i.e. real BIDS, not just sourcedata)."""
    out = {}
    if not _bids_root.exists():
        return out, []
    for p in sorted(_bids_root.iterdir()):
        m = _sub_re.match(p.name)
        if not (m and p.is_dir()):
            continue
        ses_count = sum(1 for q in p.iterdir()
                        if _ses_re.match(q.name) and (q / "func").is_dir())
        if ses_count > 0:
            out[m.group(1)] = ses_count
    return out, sorted(out)

_discovered, _all_discovered = _discover()

_include = [str(s) for s in (config.get("subjects_include") or [])]
_exclude = set(str(s) for s in (config.get("subjects_exclude") or []))
if _include:
    SUBJECTS = [s for s in _include if s in _discovered]
else:
    SUBJECTS = [s for s in _all_discovered if s not in _exclude]
SUBJECT_SESSIONS = {s: _discovered[s] for s in SUBJECTS}

# ── completeness gate ────────────────────────────────────────────────────────
# Refuse to plan MRI processing for subjects missing expected sessions.
# Triggered at config-load so the user sees the error before any sbatch fires.
if REQUIRE_COMPLETE:
    _incomplete = [
        s for s in SUBJECTS
        if SUBJECT_SESSIONS.get(s, 0) < expected_sessions(s)
    ]
    if _incomplete:
        details = "\n  ".join(
            f"sub-{s}: have {SUBJECT_SESSIONS.get(s, 0)} / expected {expected_sessions(s)}"
            for s in _incomplete
        )
        raise WorkflowError(
            "Refusing to schedule MRI processing for incomplete subjects:\n  "
            + details
            + "\nIngest the missing sessions (rsync to "
            f"{_bids_root}), set subject_expected_overrides for pilots, "
            "add them to subjects_exclude, or set require_complete: false."
        )

SMOOTHED_VARIANTS = config["smoothed_variants"]
DECODE_ROIS      = config["decode_rois"]
DECODE_NV        = config["decode_n_voxels"]
DECODE_LAM       = config["decode_lambdas"]
DECODE_NOISE     = config.get("decode_noise", ["full", "spherical"])
FI_ROIS_VONMISES = config["fi_rois_vonmises"]
FI_ROIS_APRF     = config["fi_rois_aprf"]
# EU_ROIS: expected-decoded ROIs as {desc, hemi} dicts so mask_input() can
# dispatch on wc.roi. All current entries use hemi=None (the desc carries
# the L/R; e.g., NPCr is already lateralized).
EU_ROIS  = [{"desc": r, "hemi": "None"}
            for r in config.get("expected_decoded_rois", ["NPCr"])]
EU_NV    = config.get("expected_decoded_nv",    ["100", "fdr05"])
EU_NOISE = config.get("expected_decoded_noise", ["spherical", "residual"])
BIDS             = config["bids_folder"]
REPO             = config["repo_root"]
ENV              = config["conda_env"]
FMRIPREP_DERIV   = config["fmriprep_deriv"]

DERIV   = f"{BIDS}/derivatives"
SNAKE   = f"{DERIV}/_snake"

wildcard_constraints:
    subject = r"[A-Za-z0-9]+",
    smooth  = r"(_smoothed)?",
    roi     = r"[A-Za-z0-9]+",
    # nv: numeric (top-N) OR fdrNN / psigNN tokens for the cached
    # whole-brain R²-mixture voxel-selection criteria.
    nv      = r"(\d+|fdr\d+|psig\d+)",
    lam     = r"[0-9.]+",
    noise   = r"(spherical|residual)",
    session = r"(all|\d+)",
    # model_dir: on-disk encoder dir name. Allows `.` and `-` because the
    # CV dirs use the historical `aprf.cv` / `aprf-shift.cv` / `aprf-weighted.cv`
    # convention and `aprf-weighted` / `aprf-session-shift` use hyphens.
    model_dir = r"[A-Za-z0-9][A-Za-z0-9.\-_]*",

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────
def sessions_for(subject):
    """Inclusive list of session indices for a subject (1..N)."""
    return list(range(1, SUBJECT_SESSIONS[subject] + 1))

def roi_by_desc(rois, desc):
    return next(r for r in rois if r["desc"] == desc)

def mask_path(subject, desc, hemi):
    if hemi == "None":
        return f"{DERIV}/masks/sub-{subject}/anat/sub-{subject}_space-T1w_desc-{desc}_mask.nii.gz"
    return f"{DERIV}/masks/sub-{subject}/anat/sub-{subject}_space-T1w_hemi-{hemi}_desc-{desc}_mask.nii.gz"

def mask_input(rois):
    """Return an input lambda resolving the right mask file for wildcards.roi."""
    def _inner(wc):
        r = roi_by_desc(rois, wc.roi)
        return mask_path(wc.subject, r["desc"], r["hemi"])
    return _inner

def aprf_r2(subject, variant, smooth):
    """Path to the .done sentinel for a given encoding-model variant.

    The underlying scripts (fit_aprf.py, fit_vonmises.py) write to
    derivatives/encoding_models/aprf[-{variant}]/sub-XX/func/, embedding
    `_smoothed` in the filename rather than the directory. Using a sentinel
    sidesteps the path-schema mismatch — the rule succeeds when the touch
    file exists; downstream tools read the actual NIfTIs at the
    script-native paths.
    """
    return f"{DERIV}/encoding_models/{variant}{smooth}/sub-{subject}/.done"


# ── Surface sampling: model_dir <-> fit-rule sentinel name mapping ───────────
# These dicts capture the historical hyphen/dot/underscore drift between the
# encoder scripts' on-disk dirs and the Snakemake sentinel-dir names defined
# in `aprf_r2()`. The Snakemake side (RHS) uses underscores; the on-disk
# encoder dirs (LHS) use hyphens (-weighted, -session-shift) and dots (.cv).

# R² (full-fit) model_dirs -> fit-rule sentinel variant name used by aprf_r2()
R2_MODEL_DIRS = {
    "aprf":                     "aprf",
    "vonmises":                 "vonmises",
    "aprf-weighted":            "aprf_weighted",
    "aprf-session-shift":       "aprf_session_shift",
    "aprf-gauss":               "aprf_gauss",
    "aprf-gauss-session-shift": "aprf_gauss_session_shift",
    "aprf-linear":              "aprf_linear",
}

# cvR² model_dirs -> (fit_cv_rule sentinel variant, smooth-passes-through-as-is)
# These point at the on-disk *.cv dirs that fit_*_cv.py writes per-run NIfTIs to.
CVR2_MODEL_DIRS = {
    "aprf.cv":              "aprf_cv",
    "vonmises.cv":          "vonmises_cv",
    "aprf-weighted.cv":     "aprf_weighted_cv",
    "aprf-shift.cv":        "aprf_session_shift_cv",
    "aprf-gauss.cv":        "aprf_gauss_cv",
    "aprf-gauss-shift.cv":  "aprf_gauss_session_shift_cv",
    "aprf-linear.cv":       "aprf_linear_cv",
}

# Wildcard-constraint alternations for `model_dir`, derived from the two dicts
# above so registering a new variant there is enough — the aggregate_cvr2 /
# sample_r2_to_surface constraints used to be hand-written copies and silently
# went stale (aprf-linear was missing from both). Longest-first so leftmost
# alternation can't stop at a prefix (`aprf` inside `aprf-linear`).
def _model_dir_alternation(dirs):
    return "|".join(re.escape(d) for d in sorted(dirs, key=len, reverse=True))

CVR2_DIRS_RE    = _model_dir_alternation(CVR2_MODEL_DIRS)
SURFACE_DIRS_RE = _model_dir_alternation(list(R2_MODEL_DIRS) + list(CVR2_MODEL_DIRS))


def cvr2_aggregate_sentinel(subject, model_dir, smooth):
    """Sentinel for the per-subject mean-cvR² volume aggregation."""
    return (f"{DERIV}/encoding_models/{model_dir}{smooth}/"
            f"sub-{subject}/.cvr2_aggregated")

def surface_sample_sentinel(subject, model_dir, smooth):
    """Sentinel for the per-(model, subject, smooth) surface sampling job."""
    return (f"{DERIV}/encoding_models/{model_dir}{smooth}/"
            f"sub-{subject}/.surface_sampled")

# Terminal targets per subject
def subject_targets(subject):
    sessions = sessions_for(subject)
    targets = [
        # MRIQC participant-level QC (one job per subject, smooth-invariant)
        f"{DERIV}/mriqc/sub-{subject}/.mriqc_done",
    ]
    for s in SMOOTHED_VARIANTS:
        sfx = "_smoothed" if int(s) else ""

        # Encoding models (always)
        targets += [aprf_r2(subject, v, sfx) for v in (
            "aprf", "aprf_cv", "aprf_null_cv",
            "aprf_weighted", "aprf_weighted_cv",
            "aprf_gauss", "aprf_gauss_cv",
            "vonmises", "vonmises_cv",
            "aprf_linear", "aprf_linear_cv",
        )]
        # session-shift only if subject has >= 2 MRI sessions. Includes the
        # fwhm-shift / fully-shifted / vonmises-shift "ladder" variants used
        # by cvr2_model_comparison.py — these were historically fit by hand
        # for a subset of subjects and silently left out of every new
        # subject's targets; folding them in here keeps that from recurring.
        if len(sessions) >= 2:
            targets += [
                aprf_r2(subject, "aprf_session_shift", sfx),
                aprf_r2(subject, "aprf_session_shift_cv", sfx),
                aprf_r2(subject, "aprf_fwhm_shift", sfx),
                aprf_r2(subject, "aprf_fwhm_shift_cv", sfx),
                aprf_r2(subject, "aprf_fully_shifted", sfx),
                aprf_r2(subject, "aprf_fully_shifted_cv", sfx),
                aprf_r2(subject, "vonmises_shift_cv", sfx),
                aprf_r2(subject, "aprf_gauss_session_shift", sfx),
                aprf_r2(subject, "aprf_gauss_session_shift_cv", sfx),
            ]

        # Surface sampling: R² for full-fit models, cvR² (after aggregation)
        # for the *.cv variants. The session-shift pair only if ≥ 2 sessions.
        r2_dirs   = ["aprf", "vonmises", "aprf-weighted", "aprf-gauss",
                     "aprf-linear"]
        cvr2_dirs = ["aprf.cv", "vonmises.cv", "aprf-weighted.cv",
                     "aprf-gauss.cv", "aprf-linear.cv"]
        if len(sessions) >= 2:
            r2_dirs += ["aprf-session-shift", "aprf-gauss-session-shift"]
            cvr2_dirs += ["aprf-shift.cv", "aprf-gauss-shift.cv"]
        for md in r2_dirs + cvr2_dirs:
            targets.append(surface_sample_sentinel(subject, md, sfx))

        # Decoding fan-out (sentinel files; actual TSVs at derivatives/decoding/...)
        for roi in DECODE_ROIS:
            for nv, lam, noise in product(DECODE_NV, DECODE_LAM, DECODE_NOISE):
                targets += [
                    f"{DERIV}/decoded_gabor{sfx}/sub-{subject}/"
                    f"sub-{subject}_roi-{roi['desc']}_nv-{nv}_lam-{lam}"
                    f"_noise-{noise}.done",
                    f"{DERIV}/decoded_value{sfx}/sub-{subject}/"
                    f"sub-{subject}_roi-{roi['desc']}_nv-{nv}_lam-{lam}"
                    f"_noise-{noise}.done",
                ]

        # Fisher information sentinels (actual TSVs at derivatives/encoding_models/...)
        for roi in FI_ROIS_VONMISES:
            for ses in ["all"] + [str(i) for i in sessions]:
                targets.append(
                    f"{DERIV}/fisher_information_vonmises{sfx}/sub-{subject}/"
                    f"sub-{subject}_roi-{roi['desc']}_ses-{ses}.done"
                )
        for roi in FI_ROIS_APRF:
            for ses in ["all"] + [str(i) for i in sessions]:
                targets.append(
                    f"{DERIV}/fisher_information_aprf{sfx}/sub-{subject}/"
                    f"sub-{subject}_roi-{roi['desc']}_ses-{ses}.done"
                )

        # Per-condition Fisher information (session-shift aPRF model) — feeds
        # fisher_information_per_condition.py. Only for subjects with >= 2
        # sessions (the model needs session-varying tuning); no pooled "all"
        # since mode genuinely differs per session. Historically a manual,
        # 12-subject-only run — folded into the standard target set so it
        # keeps pace with new subjects automatically.
        if len(sessions) >= 2:
            for roi in FI_ROIS_APRF:
                for nv in ["100", "fdr05"]:
                    for ses in sessions:
                        targets.append(
                            f"{DERIV}/fisher_information_aprf_session_shift{sfx}/"
                            f"sub-{subject}/sub-{subject}_roi-{roi['desc']}"
                            f"_nv-{nv}_ses-{ses}.done"
                        )

        # Expected-decoded-value (aprf-session-shift) — only for subjects
        # with ≥2 MRI sessions, since the model itself requires it.
        if len(sessions) >= 2:
            for roi, nv, noise in product(EU_ROIS, EU_NV, EU_NOISE):
                targets.append(
                    f"{DERIV}/expected_decoded_value_aprf{sfx}/sub-{subject}/"
                    f"sub-{subject}_roi-{roi['desc']}_nv-{nv}_noise-{noise}.done"
                )
    return targets


# ─────────────────────────────────────────────────────────────────────────────
# All
# ─────────────────────────────────────────────────────────────────────────────
rule all:
    input:
        expand(f"{SNAKE}/sub-{{subject}}.done", subject=SUBJECTS),
        # Group mriqc — re-runs whenever any subject's per-participant mriqc
        # finishes (because the input set changes), so cohort-level QC stays
        # in sync automatically.
        f"{DERIV}/mriqc/group_bold.tsv",
        f"{DERIV}/mriqc/group_T1w.tsv",

rule subject_complete:
    input:
        lambda wc: subject_targets(wc.subject),
    output:
        f"{SNAKE}/sub-{{subject}}.done",
    shell: "mkdir -p $(dirname {output}) && touch {output}"


# ─────────────────────────────────────────────────────────────────────────────
# Preprocessing
# ─────────────────────────────────────────────────────────────────────────────
rule fmriprep:
    output:
        # End-of-run sentinel touched by fmriprep.sh AFTER the apptainer call
        # returns. We deliberately do NOT use the .html report as the sentinel
        # because fmriprep can write the html mid-run as a progress placeholder
        # (observed 2026-05-29: sub-11 had a html report 1h into a 5h run).
        # See the **fmriprep** skill, "HTML-report vs NIfTI ground truth".
        f"{DERIV}/fmriprep/sub-{{subject}}/.fmriprep_done",
    log: "logs/fmriprep_{subject}.log"
    resources:
        # 3T 2-session subjects finish well under 24h; if a job hits the cap,
        # something's wrong — let it die rather than slipping into a 48h slot.
        # 22h leaves margin under standard partition's default qos=normal (1-day cap).
        cpus_per_task=16, mem_mb=64_000, runtime=22*60,
    params:
        bold2anat_init=config.get("bold2anat_init", "auto"),
        # Subjects whose head pose false-positives FreeSurfer's talairach_afd
        # gate need recon-all's `-notal-check`. fmriprep doesn't expose it, so
        # fmriprep.sh bind-mounts a patched recon-all when NOTAL_CHECK=1. See
        # prepare/cluster_preproc/make_notalcheck_reconall.sh for the rationale.
        notal_check=lambda w: int(
            w.subject in config.get("notal_check_subjects", [])
        ),
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} "
        "BOLD2ANAT_INIT={params.bold2anat_init} "
        "NOTAL_CHECK={params.notal_check} "
        "bash {REPO}/abstract_values/prepare/cluster_preproc/fmriprep.sh"


rule mriqc:
    output:
        # End-of-run sentinel touched by mriqc.sh after apptainer + a late-stage
        # output-existence discriminator (ses-1 T1w report HTML). Same pattern as
        # the fmriprep rule. See **fmriprep** skill, "The html exists ≠ fmriprep
        # succeeded" — same lesson applies to mriqc which also writes an html.
        f"{DERIV}/mriqc/sub-{{subject}}/.mriqc_done",
    log: "logs/mriqc_{subject}.log"
    resources:
        # 64G (not 32G): mriqc with --nprocs 4 needs ~14 GB/worker for
        # AFNI/FSL working-set spikes; 32G/8procs (the original) OOM-killed
        # in 25min on the 2026-05-31 cohort run. See mriqc.sh comment.
        cpus_per_task=8, mem_mb=64_000, runtime=4*60,
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} "
        "bash {REPO}/abstract_values/prepare/cluster_preproc/mriqc.sh"


rule mriqc_group:
    """Group-level mriqc aggregation. Re-runs whenever a new subject's
    per-participant `.mriqc_done` lands — Snakemake sees the input set
    change and re-fires this rule. Outputs are real group TSVs/HTMLs,
    not a sentinel, so deletion of a group output also forces re-run.
    """
    input:
        expand(f"{DERIV}/mriqc/sub-{{subject}}/.mriqc_done",
               subject=SUBJECTS),
    output:
        bold_tsv = f"{DERIV}/mriqc/group_bold.tsv",
        anat_tsv = f"{DERIV}/mriqc/group_T1w.tsv",
    log: "logs/mriqc_group.log"
    resources: cpus_per_task=2, mem_mb=8_000, runtime=30,
    shell:
        "bash {REPO}/abstract_values/prepare/cluster_preproc/mriqc_group.sh"


rule create_roi_masks:
    input: rules.fmriprep.output,
    output:
        # Sentinel: the underlying script writes hemi-L/-R/-LR for every Benson area.
        # Decoding/FI consumers explicitly select `hemi=LR` for BensonV1, so we
        # use the LR file as the per-subject completion marker.
        f"{DERIV}/masks/sub-{{subject}}/anat/sub-{{subject}}_space-T1w_hemi-LR_desc-BensonV1_mask.nii.gz",
    log: "logs/create_roi_masks_{subject}.log"
    resources: cpus_per_task=2, mem_mb=8_000, runtime=30,
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "bash {REPO}/abstract_values/prepare/slurm_jobs/create_roi_masks.sh"


rule create_npc_masks:
    input: rules.fmriprep.output,
    output:
        f"{DERIV}/masks/sub-{{subject}}/anat/sub-{{subject}}_space-T1w_desc-NPCr_mask.nii.gz",
    log: "logs/create_npc_masks_{subject}.log"
    resources: cpus_per_task=2, mem_mb=8_000, runtime=30,
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "bash {REPO}/abstract_values/prepare/slurm_jobs/create_npc_masks.sh"


# ─────────────────────────────────────────────────────────────────────────────
# GLMsingle (per smoothing variant)
# ─────────────────────────────────────────────────────────────────────────────
rule fit_glmsingle:
    input: rules.fmriprep.output,
    output:
        # Sentinel — actual outputs are a tree of NIfTIs under glmsingle{smooth}/sub-{subject}/
        f"{DERIV}/glmsingle{{smooth}}/sub-{{subject}}/_done.touch",
    log: "logs/fit_glmsingle{smooth}_{subject}.log"
    resources: cpus_per_task=16, mem_mb=128_000, runtime=12*60,   # 128G: 64G hit OOM on 2-session subjects; 12h: 6h hit TIMEOUT for sub-07/10 even with TR_UP=0.5
               slurm_partition="standard", slurm_account="zne.uzh",
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "SMOOTHED=$([[ '{wildcards.smooth}' == '_smoothed' ]] && echo 1 || echo 0) "
        "bash {REPO}/abstract_values/glm/slurm_jobs/fit_glmsingle.sh && "
        "mkdir -p $(dirname {output}) && touch {output}"


# ─────────────────────────────────────────────────────────────────────────────
# Encoding models
# ─────────────────────────────────────────────────────────────────────────────
def _aprf_resources():
    return dict(cpus_per_task=8, mem_mb=32_000, runtime=2*60)

# Cross-validated fits do leave-one-run-out (~16 folds for a 2-session subject),
# so they need far more walltime than the single fit. 2h TIMEOUTs the CV jobs
# for sub-13/14; 12h matches the heavy-fit precedent above and stays under the
# 1-day `normal` QoS cap.
def _aprf_cv_resources():
    return dict(cpus_per_task=8, mem_mb=32_000, runtime=12*60)

rule fit_aprf:
    input: f"{DERIV}/glmsingle{{smooth}}/sub-{{subject}}/_done.touch"
    output: aprf_r2("{subject}", "aprf", "{smooth}")
    log: "logs/fit_aprf{smooth}_{subject}.log"
    resources: **_aprf_resources()
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "SMOOTHED=$([[ '{wildcards.smooth}' == '_smoothed' ]] && echo 1 || echo 0) "
        "bash {REPO}/abstract_values/encoding_models/slurm_jobs/fit_aprf.sh && "
        "mkdir -p $(dirname {output}) && touch {output}"

rule fit_aprf_cv:
    input: f"{DERIV}/glmsingle{{smooth}}/sub-{{subject}}/_done.touch"
    output: aprf_r2("{subject}", "aprf_cv", "{smooth}")
    log: "logs/fit_aprf_cv{smooth}_{subject}.log"
    resources: **_aprf_cv_resources()
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "SMOOTHED=$([[ '{wildcards.smooth}' == '_smoothed' ]] && echo 1 || echo 0) "
        "bash {REPO}/abstract_values/encoding_models/slurm_jobs/fit_aprf_cv.sh && "
        "mkdir -p $(dirname {output}) && touch {output}"

rule fit_aprf_session_shift:
    input: f"{DERIV}/glmsingle{{smooth}}/sub-{{subject}}/_done.touch"
    output: aprf_r2("{subject}", "aprf_session_shift", "{smooth}")
    log: "logs/fit_aprf_session_shift{smooth}_{subject}.log"
    resources: **_aprf_resources()
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "MODEL=session-shift "
        "SMOOTHED=$([[ '{wildcards.smooth}' == '_smoothed' ]] && echo 1 || echo 0) "
        "bash {REPO}/abstract_values/encoding_models/slurm_jobs/fit_aprf.sh && "
        "mkdir -p $(dirname {output}) && touch {output}"

rule fit_aprf_session_shift_cv:
    input: f"{DERIV}/glmsingle{{smooth}}/sub-{{subject}}/_done.touch"
