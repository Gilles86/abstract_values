# ─────────────────────────────────────────────────────────────────────────────
# Surface sampling (R² + aggregated cvR² → fsnative + fsaverage)
# ─────────────────────────────────────────────────────────────────────────────
# Aggregates per-run cvR² NIfTIs into one mean cvR² volume (with float32
# discipline) and then samples encoding-model R² / cvR² volumes to fsnative +
# fsaverage GIfTIs, ready for the group fsaverage viz.

rule aggregate_cvr2:
    """Mean-aggregate per-run cvR² NIfTIs for one (subject, cv-model-dir, smooth).

    Depends on the fit_*_cv rule's `.done` sentinel via CVR2_MODEL_DIRS.
    Writes the mean volume to the same `func/` dir as the per-run files,
    plus a sentinel next to it.
    """
    input:
        lambda wc: aprf_r2(wc.subject,
                           CVR2_MODEL_DIRS[wc.model_dir],
                           wc.smooth),
    output:
        f"{DERIV}/encoding_models/{{model_dir}}{{smooth}}/sub-{{subject}}/.cvr2_aggregated",
    log: "logs/aggregate_cvr2_{model_dir}{smooth}_{subject}.log"
    resources: cpus_per_task=1, mem_mb=8_000, runtime=10,
    wildcard_constraints:
        # Restrict to known CV dirs so we don't accidentally try to aggregate
        # a non-CV model dir (the per-run files don't exist there).
        model_dir = CVR2_DIRS_RE,
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} MODEL_DIR={wildcards.model_dir} "
        "SMOOTHED=$([[ '{wildcards.smooth}' == '_smoothed' ]] && echo 1 || echo 0) "
        "bash {REPO}/abstract_values/encoding_models/slurm_jobs/aggregate_cvr2.sh && "
        "mkdir -p $(dirname {output}) && touch {output}"


def _surface_sample_input(wc):
    """Resolve the input sentinel for surface sampling based on model_dir.

    For full-fit r2 dirs (aprf/vonmises/aprf-weighted/aprf-session-shift):
        depend on the corresponding fit rule's `.done`.
    For *.cv dirs:
        depend on the cvR² aggregation sentinel.
    """
    md = wc.model_dir
    if md in R2_MODEL_DIRS:
        return aprf_r2(wc.subject, R2_MODEL_DIRS[md], wc.smooth)
    if md in CVR2_MODEL_DIRS:
        return cvr2_aggregate_sentinel(wc.subject, md, wc.smooth)
    raise WorkflowError(
        f"Unknown model_dir {md!r} for surface sampling. "
        f"Known: {sorted(R2_MODEL_DIRS) + sorted(CVR2_MODEL_DIRS)}"
    )


def _surface_sample_desc(wc):
    """desc-entity to sample: 'r2' for full-fit dirs, 'cvr2' for *.cv dirs."""
    return "cvr2" if wc.model_dir in CVR2_MODEL_DIRS else "r2"


rule sample_r2_to_surface:
    """Sample one encoding-model (cv)R² volume to fsnative + fsaverage GIfTIs.

    `model_dir` is the on-disk encoder dir; the desc-entity sampled is
    inferred (`r2` for full-fit dirs, `cvr2` for *.cv dirs). Smoothing
    suffix is appended to the desc by the underlying script.
    """
    input:
        # The fit / aggregation sentinel — guarantees the source NIfTI exists.
        sentinel = _surface_sample_input,
        # Also gate on fmriprep, since SurfaceTransform needs the freesurfer
        # streams + the per-session anat surfaces.
        fmriprep = rules.fmriprep.output,
    output:
        f"{DERIV}/encoding_models/{{model_dir}}{{smooth}}/sub-{{subject}}/.surface_sampled",
    log: "logs/sample_r2_to_surface_{model_dir}{smooth}_{subject}.log"
    resources: cpus_per_task=2, mem_mb=8_000, runtime=20,
    params:
        desc = _surface_sample_desc,
    wildcard_constraints:
        # Restrict to the dirs we actually surface-sample, so wildcard
        # inference can't grab an unrelated `encoding_models/*` subdir.
        model_dir = SURFACE_DIRS_RE,
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} "
        "MODEL_DIR={wildcards.model_dir} "
        "DESC={params.desc} "
        "FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "SMOOTHED=$([[ '{wildcards.smooth}' == '_smoothed' ]] && echo 1 || echo 0) "
        "bash {REPO}/abstract_values/surface/slurm_jobs/sample_r2_to_surface.sh && "
        "mkdir -p $(dirname {output}) && touch {output}"


# ─────────────────────────────────────────────────────────────────────────────
# Decoding (per ROI x n_voxels x lambda)
# ─────────────────────────────────────────────────────────────────────────────
def _decode_runtime(wc):
    # n_voxels=0 path (and the FDR-fallback path) does nested CV → needs
    # the most wall time. Driver 3315438 saw 14+ nv=0 decode jobs hit 4h
    # cap at ~3h25m elapsed; bumping to 6h for headroom.
    # nv≥250 path with lam>0 (non-trivial regularisation): driver 3609351
    # saw decode_value timeout at 60 min for sub-{07,08,10,12,14} ×
    # {NPCr,BensonV1} × {250,500} × lam=0.1. Bumped to 3 h.
    nv = int(wc.nv)
    if nv == 0:    return 360
    if nv >= 250:  return 180
    return 60

rule decode_gabor:
    input:
        glmsingle = f"{DERIV}/glmsingle{{smooth}}/sub-{{subject}}/_done.touch",
        mask      = mask_input(DECODE_ROIS),
    output:
        # Sentinel — actual decoded TSVs live at
        # derivatives/decoding/gabor/sub-XX/func/... per decode_gabor.py.
        f"{DERIV}/decoded_gabor{{smooth}}/sub-{{subject}}/"
        f"sub-{{subject}}_roi-{{roi}}_nv-{{nv}}_lam-{{lam}}_noise-{{noise}}.done",
    log: "logs/decode_gabor{smooth}_{subject}_{roi}_nv{nv}_lam{lam}_noise{noise}.log"
    resources: cpus_per_task=4, mem_mb=16_000, runtime=60,
    shell:
        "PARTICIPANT_LABEL={wildcards.subject} FMRIPREP_DERIV={FMRIPREP_DERIV} "
        "MASK={input.mask} MASK_DESC={wildcards.roi} "
        "N_VOXELS={wildcards.nv} LAMBD={wildcards.lam} "
        "SPHERICAL=$([[ '{wildcards.noise}' == 'spherical' ]] && echo 1 || echo 0) "
        "SMOOTHED=$([[ '{wildcards.smooth}' == '_smoothed' ]] && echo 1 || echo 0) "
        "bash {REPO}/abstract_values/encoding_models/slurm_jobs/decode_gabor.sh && "
        "mkdir -p $(dirname {output}) && touch {output}"

